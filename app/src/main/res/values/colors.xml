<?xml version="1.0" encoding="utf-8"?>
<!--
    XML-resource colours used only by the system (windowBackground, mipmap
    backgrounds). Compose pulls its colours from `com.tally.ui.theme` instead.

    These hex values are the committed source of truth for the three design
    anchors. The Compose theme reproduces them via OKLCH inputs calibrated to
    render to exactly these bytes (the OKLCH alongside each entry), so the
    pre-Compose splash and the first Compose frame are identical — no cold-start
    flash. OklchTest enforces the match; ADR-0003 records the calibration.
-->
<resources>
    <!-- oklch(0.2061 0.0086 240.33) — page background -->
    <color name="tally_bg0">#14181B</color>
    <!-- oklch(0.9843 0.0011 197.14) — text hi -->
    <color name="tally_text_hi">#F9FAFA</color>
    <!-- oklch(0.7422 0.1399 166.58) — emerald accent (default jewel) -->
    <color name="tally_accent_emerald">#33C798</color>
</resources>
