<?xml version="1.0" encoding="utf-8"?>
<!--
    On Android 12+, opting every Tally artefact out of cloud backup and
    device-to-device transfer. Pence-denominated transactions, encrypted
    smsRaw payloads, Keystore-wrapped DEKs, and biometric prefs all stay
    on-device. The user exports manually via Settings → Export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
