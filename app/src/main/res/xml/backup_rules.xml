<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 backup rules: nothing gets backed up, same policy. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
